{
  "name": "@datalabrotterdam/nova-ai-cli",
  "version": "1.2.0-alpha.2",
  "description": "Agentic coding with DataLab Rotterdam's Nova AI in your terminal: interactive TUI, headless mode, and an ACP agent for editors",
  "license": "Apache-2.0",
  "author": "DataLab Rotterdam",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Datalab-Rotterdam/nova-ai-cli.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Datalab-Rotterdam/nova-ai-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Datalab-Rotterdam/nova-ai-cli#readme",
  "bin": {
    "nova-ai-cli": "dist/index.js",
    "nova-ai": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run test:pty",
    "test:unit": "node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --import ./dist-test/test-support/setup-env.js --test --test-timeout=30000 \"dist-test/packages/cli/tests/**/*.test.js\"",
    "test:pty": "tsx tests/tui/pty-runtime-runner.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.29.0",
    "@datalabrotterdam/nova-ai-agent": "^1.0.0-alpha.1",
    "@datalabrotterdam/nova-sdk": "^1.3.2",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "ink": "^7.1.1",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "string-width": "^8.3.0"
  },
  "release": {
    "extends": "semantic-release-monorepo",
    "tagFormat": "@datalabrotterdam/nova-ai-cli@${version}",
    "branches": [
      "main",
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "nova-ai-cli(release): 🚀 v${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
