{
  "name": "@datalabrotterdam/nova-ai-agent",
  "version": "1.0.0",
  "description": "Nova AI coding agent as an Agent Client Protocol (ACP) server: tools, permissions, sessions, memory and MCP, backed by @datalabrotterdam/nova-sdk",
  "license": "Apache-2.0",
  "author": "DataLab Rotterdam",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Datalab-Rotterdam/nova-ai-cli.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/Datalab-Rotterdam/nova-ai-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Datalab-Rotterdam/nova-ai-cli/tree/main/packages/agent#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bin.js": "./dist/bin.js",
    "./core/*.js": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./acp/*.js": {
      "types": "./dist/acp/*.d.ts",
      "default": "./dist/acp/*.js"
    },
    "./client/*.js": {
      "types": "./dist/client/*.d.ts",
      "default": "./dist/client/*.js"
    },
    "./commands/*.js": {
      "types": "./dist/commands/*.d.ts",
      "default": "./dist/commands/*.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nova-ai-agent": "dist/bin.js"
  },
  "files": [
    "dist",
    "src/acp/web/dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm install --prefix src/acp/web && npm run build --prefix src/acp/web && npm run build:lib",
    "build:lib": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --import ./dist-test/test-support/setup-env.js --test --test-timeout=30000 \"dist-test/packages/agent/tests/**/*.test.js\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.29.0",
    "@datalabrotterdam/nova-sdk": "^1.3.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sourceregistry/node-webserver": "^1.8.0"
  },
  "release": {
    "extends": "semantic-release-monorepo",
    "tagFormat": "@datalabrotterdam/nova-ai-agent@${version}",
    "branches": [
      "main",
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "nova-ai-agent(release): 🚀 v${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
